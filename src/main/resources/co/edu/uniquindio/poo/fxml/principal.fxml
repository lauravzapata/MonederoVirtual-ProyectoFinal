<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.geometry.Insets?>
<?import javafx.scene.text.Font?>
<BorderPane xmlns:fx="http://javafx.com/fxml/1" fx:controller="co.edu.uniquindio.poo.viewcontrollers.PrincipalViewController">
<padding><Insets top="20" right="24" bottom="18" left="24"/></padding>
<top><VBox spacing="12">
 <Label text="◈  Monedero Virtual" textFill="#48337e"><font><Font name="System Bold" size="30"/></font></Label>
 <Label text="Tu dinero organizado. Cada movimiento cuenta." textFill="#655b78"><font><Font size="14"/></font></Label>
 <Separator/>
 <Label fx:id="resumen" text="Selecciona un cliente para comenzar." textFill="#48337e"><font><Font name="System Bold" size="18"/></font></Label>
                    <TitledPane text="Tu cuenta · Clientes y monederos" collapsible="false" expanded="true">
                        <content><VBox spacing="8">
                            <HBox spacing="8">
                                <TextField fx:id="documento" promptText="Documento" prefWidth="160"/>
                                <TextField fx:id="nombre" promptText="Nombre del cliente" prefWidth="230"/>
                                <Button text="Registrar cliente" onAction="#registrarCliente"/>
                                <Button text="Editar nombre" onAction="#editarCliente"/>
                                <Button text="Eliminar cliente" onAction="#eliminarCliente"/>
                            </HBox>
                            <HBox spacing="8">
                                <ComboBox fx:id="cliente" promptText="Selecciona cliente" prefWidth="280"/>
                                <ComboBox fx:id="monedero" promptText="Selecciona monedero" prefWidth="240"/>
                            </HBox>
                            <HBox spacing="8">
                                <TextField fx:id="nombreMonedero" promptText="Nuevo monedero (ej. Ahorros)" prefWidth="280"/>
                                <Button text="Crear monedero" onAction="#registrarMonedero"/>
                            </HBox>
                        </VBox></content>
                    </TitledPane><Label text="Las operaciones usan el cliente y monedero seleccionados. Para transferir, elige también el destino." textFill="#655b78"/>
<Separator/>
</VBox></top>
<center><TabPane tabClosingPolicy="UNAVAILABLE"><tabs>
<Tab text="Movimientos"><content><ScrollPane fitToWidth="true"><content><VBox spacing="16"><padding><Insets top="18" right="12" bottom="18" left="12"/></padding><Label text="Deposita, retira o transfiere. Consulta tu actividad y tus gastos." wrapText="true" textFill="#655b78"/><VBox spacing="8">
                            <HBox spacing="8">
                                <TextField fx:id="monto" promptText="Monto (ej. 1000)" prefWidth="180"/>
                                <Button text="Depositar" onAction="#depositar"/>
                                <Button text="Retirar" onAction="#retirar"/>
                                <Button text="Ver historial" onAction="#historial"/>
                                <Button text="Reporte de gastos" onAction="#reporte"/>
                            </HBox>
                            <HBox spacing="8">
                                <ComboBox fx:id="destinatario" promptText="Cliente destino" prefWidth="280"/>
                                <ComboBox fx:id="monederoDestino" promptText="Monedero destino" prefWidth="240"/>
                                <Button text="Transferir" onAction="#transferir"/>
                            </HBox>
                            <HBox spacing="8">
                                <TextField fx:id="codigo" promptText="Código de transacción a revertir" prefWidth="265"/>
                                <Button text="Revertir transacción" onAction="#revertir"/>
                            </HBox>
                        </VBox></VBox></content></ScrollPane></content></Tab>
<Tab text="Puntos y beneficios"><content><ScrollPane fitToWidth="true"><content><VBox spacing="16"><padding><Insets top="18" right="12" bottom="18" left="12"/></padding><Label text="Convierte tus puntos en beneficios. El rango se calcula con tus puntos disponibles." wrapText="true" textFill="#655b78"/><HBox spacing="8">
                            <Button text="100 puntos: descuento" onAction="#canjear100"/>
                            <Button text="500 puntos: retiros gratis" onAction="#canjear500"/>
                            <Button text="1000 puntos: bono $50" onAction="#canjear1000"/>
                            <Button text="Historial de puntos" onAction="#historialPuntos"/>
                        </HBox></VBox></content></ScrollPane></content></Tab>
<Tab text="Programadas"><content><ScrollPane fitToWidth="true"><content><VBox spacing="16"><padding><Insets top="18" right="12" bottom="18" left="12"/></padding><Label text="Usa el monto y el destino de Movimientos. Las pendientes se procesan al pulsar Ejecutar vencidas." wrapText="true" textFill="#655b78"/><VBox spacing="10"><HBox spacing="8"><Label text="Destino:"/><Label text="Seleccionado en la pestaña Movimientos"/></HBox><VBox spacing="8">
                            <HBox spacing="8">
                                <ComboBox fx:id="tipoProgramada" prefWidth="150"/>
                                <DatePicker fx:id="fecha" prefWidth="175"/>
                                <ComboBox fx:id="frecuencia" prefWidth="150"/>
                                <Button text="Programar" onAction="#programar"/>
                                <Button text="Ejecutar vencidas" onAction="#ejecutarProgramadas"/>
                            </HBox>
                            <HBox spacing="8">
                                <Button text="Ver programadas" onAction="#verProgramadas"/>
                                <TextField fx:id="codigoProgramada" promptText="Código programada" prefWidth="180"/>
                                <Button text="Cancelar programada" onAction="#cancelarProgramada"/>
                            </HBox>
                        </VBox></VBox></VBox></content></ScrollPane></content></Tab>
</tabs></TabPane></center>
<bottom><VBox spacing="8">
<Separator/>
<HBox spacing="12" alignment="CENTER_LEFT"><Label text="Actividad y resultados" textFill="#48337e"><font><Font name="System Bold" size="15"/></font></Label><Button text="Ver notificaciones" onAction="#verNotificaciones"/></HBox>
<TextArea fx:id="salida" editable="false" prefRowCount="6" wrapText="true" promptText="Aquí aparecerán tus operaciones y alertas."/>
<Label text="Simulador académico · Datos en memoria durante esta sesión · Comisión base: 1%" textFill="#655b78"/>
</VBox></bottom>
</BorderPane>
